# Copy to deploy/.env and fill in. Never commit the real file.

# Public address (DNS record pointing at this server). Caddy gets the HTTPS certificate for it.
APP_DOMAIN=workbook.example.com
APP_PUBLIC_URL=https://workbook.example.com

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
POSTGRES_PASSWORD=

# Outgoing email (confirmation and password reset).
APP_EMAIL_BACKEND=smtp
APP_EMAIL_FROM=AI Project Workbook <no-reply@example.com>
APP_SMTP_HOST=
APP_SMTP_PORT=587
APP_SMTP_USERNAME=
APP_SMTP_PASSWORD=
APP_SMTP_STARTTLS=true

# Optional: sign-in with Google (redirect URI: https://<domain>/api/auth/google/callback).
APP_GOOGLE_CLIENT_ID=
APP_GOOGLE_CLIENT_SECRET=

# Days of nightly database backups to keep in deploy/backups.
BACKUP_KEEP_DAYS=14
