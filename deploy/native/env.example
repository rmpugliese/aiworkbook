# Copy to /srv/apps/aiworkbook/deploy/.env (chmod 600). Never commit the real file.
APP_ENV=production
APP_PUBLIC_URL=https://aiworkbook.perlconsulting.it

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=

# Local PostgreSQL (see DEPLOY.md): user and database "workbook".
APP_DATABASE_URL=postgresql+psycopg://workbook:CHANGE_ME@127.0.0.1:5432/workbook

# Outgoing email (confirmation and password reset).
APP_EMAIL_BACKEND=smtp
APP_EMAIL_FROM=AI Project Workbook <no-reply@perlconsulting.it>
APP_SMTP_HOST=
APP_SMTP_PORT=587
APP_SMTP_USERNAME=
APP_SMTP_PASSWORD=
APP_SMTP_STARTTLS=true

# Optional: sign-in with Google (redirect URI: https://aiworkbook.perlconsulting.it/api/auth/google/callback).
APP_GOOGLE_CLIENT_ID=
APP_GOOGLE_CLIENT_SECRET=

# Port the reverse proxy forwards to (Nginx Proxy Manager → 167.86.115.64:8000).
PORT=8000
