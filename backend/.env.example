# Copy to .env and adjust. All variables use the APP_ prefix.
APP_ENV=development
APP_DATABASE_URL=sqlite:///./dev.db

# Required in production: a long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
APP_SECRET_KEY=dev-only-secret-key-change-me
# The address of the frontend as the browser sees it: used in email links and redirects.
APP_PUBLIC_URL=http://localhost:5173
APP_SESSION_DAYS=30

# Email: "console" prints emails (with their links) in the backend log; "smtp" sends them.
APP_EMAIL_BACKEND=console
APP_EMAIL_FROM=AI Project Workbook <no-reply@example.com>
# APP_SMTP_HOST=smtp.example.com
# APP_SMTP_PORT=587
# APP_SMTP_USERNAME=
# APP_SMTP_PASSWORD=
# APP_SMTP_STARTTLS=true

# Sign in with Google: create an OAuth client (type "Web application") in Google Cloud Console
# with the authorised redirect URI  <APP_PUBLIC_URL>/api/auth/google/callback
# APP_GOOGLE_CLIENT_ID=
# APP_GOOGLE_CLIENT_SECRET=
